{
  "version": 2,
  "builds": [
    {
      "src": "*/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "*/sketch.js",
      "use": "@vercel/static"
    },
    {
      "src": "*/script.js",
      "use": "@vercel/static"
    },
    {
      "src": "*/style.css",
      "use": "@vercel/static"
    },
    {
      "src": "*/samples/**",
      "use": "@vercel/static"
    },
    {
      "src": "*/audio/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.mp3",
      "use": "@vercel/static"
    },
    {
      "src": "*.aif",
      "use": "@vercel/static"
    },
    {
      "src": "*/libraries/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/breathing",
      "destination": "/breathing/index.html"
    },
    {
      "source": "/breathing/(.*)",
      "destination": "/breathing/index.html"
    },
    {
      "source": "/electricBrightness",
      "destination": "/electricBrightness/index.html"
    },
    {
      "source": "/electricBrightness/(.*)",
      "destination": "/electricBrightness/index.html"
    },
    {
      "source": "/electricBrightnessSound",
      "destination": "/electricBrightnessSound/index.html"
    },
    {
      "source": "/electricBrightnessSound/(.*)",
      "destination": "/electricBrightnessSound/index.html"
    },
    {
      "source": "/imageScanSynth",
      "destination": "/imageScanSynth/index.html"
    },
    {
      "source": "/imageScanSynth/(.*)",
      "destination": "/imageScanSynth/index.html"
    },
    {
      "source": "/roughWaters",
      "destination": "/roughWaters/index.html"
    },
    {
      "source": "/roughWaters/(.*)",
      "destination": "/roughWaters/index.html"
    },
    {
      "source": "/roughWatersAudioZoom",
      "destination": "/roughWatersAudioZoom/index.html"
    },
    {
      "source": "/roughWatersAudioZoom/(.*)",
      "destination": "/roughWatersAudioZoom/index.html"
    },
    {
      "source": "/starsounds2d",
      "destination": "/starsounds2d/index.html"
    },
    {
      "source": "/starsounds2d/(.*)",
      "destination": "/starsounds2d/index.html"
    },
    {
      "source": "/starsounds3d",
      "destination": "/starsounds3d/index.html"
    },
    {
      "source": "/starsounds3d/(.*)",
      "destination": "/starsounds3d/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(mp3|aif|wav|ogg))",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
} 