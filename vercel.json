{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.mp3",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.aif",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.wav",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.png",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/breathing",
      "destination": "/breathing/index-p5.html"
    },
    {
      "source": "/electricBrightness",
      "destination": "/electricBrightness/index-p5.html"
    },
    {
      "source": "/electricBrightnessSound",
      "destination": "/electricBrightnessSound/index.html"
    },
    {
      "source": "/imageScanSynth",
      "destination": "/imageScanSynth/index.html"
    },
    {
      "source": "/roughWaters",
      "destination": "/roughWaters/index.html"
    },
    {
      "source": "/roughWatersAudioZoom",
      "destination": "/roughWatersAudioZoom/index.html"
    },
    {
      "source": "/starsounds2d",
      "destination": "/starsounds2d/index.html"
    },
    {
      "source": "/starsounds3d",
      "destination": "/starsounds3d/index.html"
    },
    {
      "source": "/",
      "destination": "/server.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*).mp3",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/(.*).aif",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/(.*).wav",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
} 